{
  "name": "pushify-cli",
  "version": "0.2.0-beta.2",
  "description": "CLI tool for Pushify deployment platform",
  "type": "module",
  "bin": {
    "pushify": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pushify",
    "deploy",
    "cli",
    "deployment",
    "devops",
    "ci-cd"
  ],
  "author": "Pushify",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pushifydev/pushify_cli"
  },
  "homepage": "https://pushify.dev",
  "bugs": {
    "url": "https://github.com/pushifydev/pushify_cli/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
